+++ b/src/cli.mjs
@@ -0,0 +1,20 @@
+// node src/cli.mjs <command> <file> ...: the pantry's commands.
+
+import { addItem } from './pantry.mjs';
+import { load, save } from './store.mjs';
+
+const [command, file, ...rest] = process.argv.slice(2);
+
+switch (command) {
+  case 'add': {
+    const [name, bestBefore] = rest;
+    save(file, addItem(load(file), { name, bestBefore }));
+    break;
+  }
+  case 'list':
+    for (const item of load(file)) console.log(`${item.bestBefore}  ${item.name}`);
+    break;
+  default:
+    console.error('usage: node src/cli.mjs add|list <file> ...');
+    process.exitCode = 2;
+}
