@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { addItem } from '../src/pantry.mjs';
+
+test('adds an item in order of name', () => {
+  const items = addItem([{ name: 'rice', bestBefore: '2027-01-01' }], {
+    name: 'milk',
+    bestBefore: '2026-05-04',
+  });
+  assert.deepEqual(
+    items.map((item) => item.name),
+    ['milk', 'rice'],
+  );
+});
