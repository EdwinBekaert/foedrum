+// What pantry does with a list of items: plain data in, plain data out.
+
+/** `items` with `item` added, sorted by name. */
+export function addItem(items, item) {
+  return [...items, item].sort((a, b) => a.name.localeCompare(b.name));
+}
diff --git a/src/store.mjs b/src/store.mjs
new file mode 100644
index 0000000..009ab80
--- /dev/null
+++ b/src/store.mjs
@@ -0,0 +1,23 @@
+// The only module that reads and writes pantry files (CLAUDE.md).
+
+import { readFileSync, writeFileSync } from 'node:fs';
+
+/** The items of the pantry file at `file`, each with a name and a valid best-before date. */
+export function load(file) {
+  const items = JSON.parse(readFileSync(file, 'utf8'));
+  if (!Array.isArray(items)) throw new Error(`${file} is not a list of items`);
+  for (const item of items) {
+    if (typeof item?.name !== 'string' || item.name === '') {
+      throw new Error(`${file} has an item without a name`);
+    }
+    if (typeof item.bestBefore !== 'string' || Number.isNaN(Date.parse(item.bestBefore))) {
+      throw new Error(`${file}: ${item.name} has no valid best-before date`);
+    }
+  }
+  return items;
+}
+
+/** Writes `items` to the pantry file at `file`. */
+export function save(file, items) {
+  writeFileSync(file, `${JSON.stringify(items, null, 2)}\n`);
+}
