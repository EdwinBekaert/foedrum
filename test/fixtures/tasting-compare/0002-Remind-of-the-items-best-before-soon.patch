 test('adds an item in order of name', () => {
   const items = addItem([{ name: 'rice', bestBefore: '2027-01-01' }], {
@@ -12,3 +12,14 @@ test('adds an item in order of name', () => {
     ['milk', 'rice'],
   );
 });
+
+const ITEMS = [
+  { name: 'milk', bestBefore: '2026-05-04' },
+  { name: 'eggs', bestBefore: '2026-05-02' },
+  { name: 'rice', bestBefore: '2027-01-01' },
+];
+
+test('lists the items best before in the next few days, soonest first', () => {
+  const soon = expiringSoon(ITEMS, new Date('2026-05-01T00:00:00Z'), 3);
+  assert.ok(soon.every((item) => ITEMS.some(({ name }) => name === item.name)));
+});
