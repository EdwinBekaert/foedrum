// Multi-repository change with release dependencies; refined in an engineer's session.
{
  "$schema": "../../../schemas/recipe.json",
  "name": "keg",
  "description": "Multi-repository change with release dependencies",
  "match": { "labels": ["multi-repo"] },
  "testFirst": false,
  "steps": [
    { "id": "context", "brewer": "maltster" },
    { "id": "refine", "session": "refine", "deadline": "2d", "fallback": "brewmaster" },
    { "id": "approve-breakdown", "gate": "human", "deadline": "3d" },
    { "id": "brew", "fanOut": { "approval": false, "bottling": "perSubOrder" } },
    { "id": "report", "action": "comment" }
  ]
}
