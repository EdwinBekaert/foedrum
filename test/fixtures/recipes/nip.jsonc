// Quick fix: no plan, one tasting.
{
  "$schema": "../../../schemas/recipe.json",
  "name": "nip",
  "type": "brew",
  "description": "Quick fix in one repository",
  "guidance": {
    "chooseWhen": "An order a test brews",
    "notWhen": "An order no test brews",
    "bestUsed": "In a test"
  },
  "steps": [
    { "id": "gauge", "brewer": "gauger", "when": "recipe.testFirst" },
    {
      "id": "red",
      "check": "test",
      "expect": "fail",
      "of": "gauge",
      "when": "recipe.testFirst",
      "onFail": { "goto": "gauge", "maxRounds": 1 }
    },
    { "id": "implement", "brewer": "cellarman" },
    {
      "id": "green",
      "check": ["build", "typecheck", "lint", "format", "test"],
      "onFail": { "goto": "implement", "maxRounds": 1 }
    },
    { "brewer": "taster", "lens": "diff/correctness" },
    { "action": "openPullRequest" }
  ]
}
