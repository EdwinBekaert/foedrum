// The example from docs/brewers-and-recipes.md §3.
{
  "$schema": "../../../schemas/recipe.json",
  "name": "half-pint",
  "type": "brew",
  "description": "Small feature in one repository",
  "guidance": {
    "chooseWhen": "An order a test brews",
    "notWhen": "An order no test brews",
    "bestUsed": "In a test"
  },
  "testFirst": true,
  "steps": [
    { "id": "plan", "brewer": "brewmaster", "model": "strong", "effort": "larger" },
    {
      "id": "gauge",
      "brewer": "gauger",
      "model": "standard",
      "effort": "larger",
      "when": "recipe.testFirst"
    },
    {
      "id": "red",
      "check": "test",
      "expect": "fail",
      "of": "gauge",
      "when": "recipe.testFirst",
      "onFail": { "goto": "gauge", "maxRounds": 1 }
    },
    {
      "id": "implement",
      "brewer": "cellarman",
      "model": "standard",
      "effort": "larger",
      "onBlocked": { "findings": { "goto": "gauge", "maxRounds": 1 } }
    },
    {
      "id": "green",
      "check": ["typecheck", "lint", "test"],
      "onFail": { "goto": "implement", "maxRounds": 2 }
    },
    {
      "id": "review",
      "loop": {
        "maxRounds": 2,
        "until": "tasting.verdict == 'approve'",
        "steps": [
          {
            "id": "tasting",
            "parallel": [
              {
                "id": "correctness",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/correctness"
              },
              {
                "id": "security",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/security"
              },
              {
                "id": "test-design",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/test-design"
              },
              { "id": "mutants", "brewer": "brett", "model": "standard", "effort": "moderate" }
            ]
          },
          {
            "id": "fix",
            "brewer": "cooper",
            "model": "standard",
            "effort": "moderate",
            "when": "tasting.verdict != 'approve'"
          },
          {
            "id": "recheck",
            "check": ["typecheck", "lint", "test"],
            "when": "tasting.verdict != 'approve'",
            "onFail": { "goto": "fix", "maxRounds": 2 }
          }
        ]
      },
      "onExhausted": "stuck"
    },
    { "action": "openPullRequest" }
  ]
}
