// Medium feature, with plan approval.
{
  "$schema": "../../../schemas/recipe.json",
  "name": "pint",
  "description": "Medium feature in one repository, with plan approval",
  "match": { "labels": ["feature", "medium"] },
  "budget": { "minutes": 180 },
  "steps": [
    { "id": "context", "brewer": "maltster" },
    { "id": "plan", "brewer": "brewmaster" },
    { "id": "approve-plan", "gate": "human", "deadline": "3d" },
    { "id": "gauge", "brewer": "gauger", "when": "recipe.testFirst" },
    {
      "id": "red",
      "check": "test",
      "expect": "fail",
      "of": "gauge",
      "when": "recipe.testFirst",
      "onFail": { "goto": "gauge", "maxRounds": 1 }
    },
    {
      "id": "implement",
      "brewer": "cellarman",
      "deadline": "45m",
      "onBlocked": { "findings": { "goto": "gauge", "maxRounds": 1 } }
    },
    {
      "id": "green",
      "check": ["build", "typecheck", "lint", "test"],
      "onFail": { "goto": "implement", "maxRounds": 2 }
    },
    {
      "id": "review",
      "loop": {
        "maxRounds": 3,
        "until": "tasting.verdict == 'approve'",
        "steps": [
          {
            "id": "tasting",
            "parallel": [
              { "id": "correctness", "brewer": "taster", "lens": "correctness" },
              { "id": "security", "brewer": "taster", "lens": "security" },
              { "id": "cross-platform", "brewer": "taster", "lens": "cross-platform" },
              { "id": "design", "brewer": "taster", "lens": "design-conformance" },
              { "id": "test-design", "brewer": "taster", "lens": "test-design" },
              { "id": "mutants", "brewer": "brett", "blocking": false }
            ]
          },
          { "id": "fix", "brewer": "cooper", "when": "tasting.verdict != 'approve'" },
          {
            "id": "recheck",
            "check": ["build", "typecheck", "lint", "test"],
            "when": "tasting.verdict != 'approve'",
            "onFail": { "goto": "fix", "maxRounds": 2 }
          }
        ]
      }
    },
    { "action": "openPullRequest" }
  ]
}
