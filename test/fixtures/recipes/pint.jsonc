// Medium feature, with plan approval.
{
  "$schema": "../../../schemas/recipe.json",
  "name": "pint",
  "type": "brew",
  "description": "Medium feature in one repository, with plan approval",
  "guidance": {
    "chooseWhen": "An order a test brews",
    "notWhen": "An order no test brews",
    "bestUsed": "In a test"
  },
  "steps": [
    { "id": "context", "brewer": "maltster-survey", "model": "standard", "effort": "moderate" },
    { "id": "plan", "brewer": "brewmaster", "model": "strong", "effort": "larger" },
    { "id": "approve-plan", "gate": "human", "deadline": "3d" },
    {
      "id": "gauge",
      "brewer": "gauger",
      "model": "standard",
      "effort": "larger",
      "when": "recipe.testFirst"
    },
    {
      "id": "red",
      "check": "test",
      "expect": "fail",
      "of": "gauge",
      "when": "recipe.testFirst",
      "onFail": { "goto": "gauge", "maxRounds": 1 }
    },
    {
      "id": "implement",
      "brewer": "cellarman",
      "model": "standard",
      "effort": "larger",
      "deadline": "45m",
      "onBlocked": { "findings": { "goto": "gauge", "maxRounds": 1 } }
    },
    {
      "id": "green",
      "check": ["build", "typecheck", "lint", "test"],
      "onFail": { "goto": "implement", "maxRounds": 2 }
    },
    {
      "id": "review",
      "loop": {
        "maxRounds": 3,
        "until": "tasting.verdict == 'approve'",
        "steps": [
          {
            "id": "tasting",
            "parallel": [
              {
                "id": "correctness",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/correctness"
              },
              {
                "id": "security",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/security"
              },
              {
                "id": "cross-platform",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/cross-platform"
              },
              {
                "id": "design",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/design-conformance"
              },
              {
                "id": "test-design",
                "brewer": "taster",
                "model": "standard",
                "effort": "moderate",
                "lens": "diff/test-design"
              },
              {
                "id": "mutants",
                "brewer": "brett",
                "model": "standard",
                "effort": "moderate",
                "blocking": false
              }
            ]
          },
          {
            "id": "fix",
            "brewer": "cooper",
            "model": "standard",
            "effort": "moderate",
            "when": "tasting.verdict != 'approve'"
          },
          {
            "id": "recheck",
            "check": ["build", "typecheck", "lint", "test"],
            "when": "tasting.verdict != 'approve'",
            "onFail": { "goto": "fix", "maxRounds": 2 }
          }
        ]
      }
    },
    { "action": "openPullRequest" }
  ]
}
