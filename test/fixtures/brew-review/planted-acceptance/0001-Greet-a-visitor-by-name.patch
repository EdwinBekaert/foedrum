From 10124203df6e07f1c6b82b2e375762ef8cc1e845 Mon Sep 17 00:00:00 2001
From: Sample <sample@example.test>
Date: Sun, 25 Oct 2026 20:46:22 +0100
Subject: [PATCH 1/2] Greet a visitor by name

---
 README.md      | 3 +++
 greet.mjs      | 3 +++
 greet.test.mjs | 7 +++++++
 3 files changed, 13 insertions(+)
 create mode 100644 README.md
 create mode 100644 greet.mjs
 create mode 100644 greet.test.mjs

diff --git a/README.md b/README.md
new file mode 100644
index 0000000..257da82
--- /dev/null
+++ b/README.md
@@ -0,0 +1,3 @@
+# greet
+
+`greet(name)` says hello to a visitor by name.
diff --git a/greet.mjs b/greet.mjs
new file mode 100644
index 0000000..69c66f0
--- /dev/null
+++ b/greet.mjs
@@ -0,0 +1,3 @@
+export function greet(name) {
+  return 'Hello, ' + name + '!';
+}
diff --git a/greet.test.mjs b/greet.test.mjs
new file mode 100644
index 0000000..38ce7b6
--- /dev/null
+++ b/greet.test.mjs
@@ -0,0 +1,7 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { greet } from './greet.mjs';
+
+test('greets a visitor by name', () => {
+  assert.equal(greet('Ann'), 'Hello, Ann!');
+});
-- 
