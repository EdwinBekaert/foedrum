From: Edwin Bekaert <48248357+EdwinBekaert@users.noreply.github.com>
Date: Thu, 15 Oct 2026 11:26:02 +0200
Subject: [PATCH 6/8] Read the current branch with git

---
 src/workspace/current-branch.ts | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/workspace/current-branch.ts b/src/workspace/current-branch.ts
index 0ea036c..9d1d496 100644
--- a/src/workspace/current-branch.ts
+++ b/src/workspace/current-branch.ts
@@ -1,3 +1,5 @@
-export const currentBranch = (_worktree: string): string => {
-  throw new Error('not implemented');
-};
+import { execFileSync } from 'node:child_process';
+
+/** The branch checked out in a worktree. */
+export const currentBranch = (worktree: string): string =>
+  execFileSync('git', ['branch', '--show-current'], { cwd: worktree, encoding: 'utf8' }).trim();
