From 6ece0c5d5626a3562133f909d9ca57b6fab455bf Mon Sep 17 00:00:00 2001
From: Edwin Bekaert <48248357+EdwinBekaert@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:06:09 +0100
Subject: [PATCH 12/13] Remove backoffSeconds: nothing calls it

Its test goes with it; the backoffMs tests are unchanged.
---
 src/engine/backoff.ts     | 3 ---
 test/unit/backoff.test.ts | 8 +-------
 2 files changed, 1 insertion(+), 10 deletions(-)

diff --git a/src/engine/backoff.ts b/src/engine/backoff.ts
index 3ff6dfad..e72a95f5 100644
--- a/src/engine/backoff.ts
+++ b/src/engine/backoff.ts
@@ -2,6 +2,3 @@ export type BackoffOptions = { readonly baseMs: number; readonly capMs: number }
 
 export const backoffMs = (attempt: number, { baseMs, capMs }: BackoffOptions): number =>
   Math.min(capMs, baseMs * 2 ** (attempt - 1));
-
-export const backoffSeconds = (attempt: number, options: BackoffOptions): number =>
-  Math.ceil(backoffMs(attempt, options) / 1000);
diff --git a/test/unit/backoff.test.ts b/test/unit/backoff.test.ts
index 1bf35bfa..0aa7f947 100644
--- a/test/unit/backoff.test.ts
+++ b/test/unit/backoff.test.ts
@@ -1,6 +1,6 @@
 import assert from 'node:assert/strict';
 import { describe, it } from 'node:test';
-import { backoffMs, backoffSeconds } from '../../src/engine/backoff.ts';
+import { backoffMs } from '../../src/engine/backoff.ts';
 
 describe('backoffMs', () => {
   it('doubles the delay for every attempt', () => {
@@ -14,9 +14,3 @@ describe('backoffMs', () => {
     assert.equal(backoffMs(20, { baseMs: 100, capMs: 10_000 }), 10_000);
   });
 });
-
-describe('backoffSeconds', () => {
-  it('rounds the delay up to whole seconds', () => {
-    assert.equal(backoffSeconds(3, { baseMs: 300, capMs: 10_000 }), 2);
-  });
-});
-- 
