From: Edwin Bekaert <48248357+EdwinBekaert@users.noreply.github.com>
Date: Wed, 14 Oct 2026 09:15:56 +0200
Subject: [PATCH 5/5] Test waiting for a merge

---
 test/unit/wait-for-merge.test.ts | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)
 create mode 100644 test/unit/wait-for-merge.test.ts

diff --git a/test/unit/wait-for-merge.test.ts b/test/unit/wait-for-merge.test.ts
new file mode 100644
index 0000000..b480b20
--- /dev/null
+++ b/test/unit/wait-for-merge.test.ts
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { eventStorePath, waitForMerge } from '../../src/engine/wait-for-merge.ts';
+
+describe('waitForMerge', () => {
+  it('returns once the pull request is merged', async () => {
+    const answers = [false, false, true];
+    let sleeps = 0;
+    await waitForMerge(
+      async () => answers.shift() ?? true,
+      { sleep: async () => { sleeps += 1; } },
+      1_000,
+    );
+    assert.equal(sleeps, 2);
+  });
+});
+
+describe('eventStorePath', () => {
+  it('puts the event store under the Brewery directory', () => {
+    assert.match(eventStorePath('my-brewery'), /my-brewery/);
+  });
+});
