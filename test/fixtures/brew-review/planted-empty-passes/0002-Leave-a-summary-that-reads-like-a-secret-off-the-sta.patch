From eaaeca14a48283b9f6e2bb1273079954ad4660c8 Mon Sep 17 00:00:00 2001
From: Sample <sample@example.test>
Date: Mon, 16 Nov 2026 17:55:05 +0100
Subject: [PATCH 2/2] Leave a summary that reads like a secret off the status

---
 src/status.mjs       | 6 +++++-
 test/status.test.mjs | 5 +++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/status.mjs b/src/status.mjs
index 73d3aee..8c51acf 100644
--- a/src/status.mjs
+++ b/src/status.mjs
@@ -1,4 +1,8 @@
+// A GitHub token: a summary that holds one stays off the status comment.
+const TOKEN = /\bgh[pousr]_[A-Za-z0-9]{36}\b/;
+
 // The status comment of a batch: its id, its lane and the summary its last step wrote.
 export function renderStatus(batch) {
-  return [`## Batch ${batch.id}`, `**Lane**: ${batch.lane}`, `**Summary**: ${batch.summary}`].join('\n');
+  const summary = TOKEN.test(batch.summary) ? '(left out: it reads like a secret)' : batch.summary;
+  return [`## Batch ${batch.id}`, `**Lane**: ${batch.lane}`, `**Summary**: ${summary}`].join('\n');
 }
diff --git a/test/status.test.mjs b/test/status.test.mjs
index ef1dddb..4082972 100644
--- a/test/status.test.mjs
+++ b/test/status.test.mjs
@@ -10,3 +10,8 @@ test("shows a batch's lane and its last summary", () => {
     '## Batch 7-1\n**Lane**: brewing\n**Summary**: Added the parser.',
   );
 });
+
+test('leaves out a summary that reads like a secret', () => {
+  const token = `ghp_${'a'.repeat(36)}`;
+  assert.doesNotMatch(renderStatus({ ...batch, summary: `Pushed with ${token}` }), /ghp_/);
+});
