+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { add, clamp } from '../src/calc.ts';
+
+const sums: [number, number, number][] = [
+  [1, 2, 3],
+  [-1, 1, 0],
+];
+for (const [a, b, sum] of sums) {
+  test(`add ${a} ${b}`, () => assert.equal(add(a, b), sum));
+}
+
+test('clamps below', () => assert.equal(clamp(-5, 0, 10), 0));
+test('keeps inside', () => assert.equal(clamp(5, 0, 10), 5));
