+namespace Calc;
+
+public static class Calculator
+{
+    public static int Add(int a, int b)
+    {
+        return a + b;
+    }
+
+    public static int Clamp(int value, int low, int high)
+    {
+        if (value < low) return low;
+        if (value > high) return high;
+        return value;
+    }
+}
