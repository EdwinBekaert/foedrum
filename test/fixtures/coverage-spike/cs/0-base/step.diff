@@ -0,0 +1,17 @@
+using Calc;
+
+namespace Calc.Tests;
+
+public class CalculatorTests
+{
+    [Theory]
+    [InlineData(1, 2, 3)]
+    [InlineData(-1, 1, 0)]
+    public void Adds(int a, int b, int sum) => Assert.Equal(sum, Calculator.Add(a, b));
+
+    [Fact]
+    public void ClampsBelow() => Assert.Equal(0, Calculator.Clamp(-5, 0, 10));
+
+    [Fact]
+    public void KeepsInside() => Assert.Equal(5, Calculator.Clamp(5, 0, 10));
+}
