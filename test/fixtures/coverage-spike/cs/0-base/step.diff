+namespace Calc;
+
+// No test calls this class.
+public static class Legacy
+{
+    public static string Percent(int part, int whole)
+    {
+        var ratio = (double)part / whole;
+        return $"{Math.Round(ratio * 100)}%";
+    }
+}
