   2  batch.ordered        {"order":{"issue":12},"routeBy":"2026-12-31T00:00:00.000Z"}
   3  batch.recipe_chosen  {"recipe":"feature","reason":"label recipe:feature","source":"label"}
   4  step.scheduled       {"stepId":"plan","attempt":1,"deadlineAt":"2026-10-15T10:00:00.000Z"}
   5  step.started         {"stepId":"plan","attempt":1}
   6  step.finished        {"stepId":"plan","attempt":1,"outcome":{"kind":"failed","retryable":true,"reason":"the out doc is missing"}}
   7  step.scheduled       {"stepId":"plan","attempt":2,"deadlineAt":"2026-10-15T10:00:00.000Z"}
   8  step.started         {"stepId":"plan","attempt":2}
   9  step.finished        {"stepId":"plan","attempt":2,"outcome":{"kind":"succeeded","output":{}}}
  10  step.scheduled       {"stepId":"implement","attempt":1,"deadlineAt":"2026-10-15T12:00:00.000Z"}
  11  step.started         {"stepId":"implement","attempt":1}
  12  effect.applied       {"key":"[\\"12-1\\",\\"implement\\",1,\\"push\\"]","result":{"commit":"4b825dc642cb6eb9a060e54bf8d69288fbee4904"}}

State
  state   Running: step implement
  recipe  feature, chosen by label: label recipe:feature
  out docs  on the state branch at batches/12-1/<step>-<attempt>.md
  steps
    plan       #1 finished: failed: the out doc is missing; #2 finished: succeeded
    implement  #1 started

`;

