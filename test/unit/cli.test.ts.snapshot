  15  batch.ordered        {"order":{"issue":14},"parentBatchId":"12-1","routeBy":"2026-12-31T00:00:00.000Z"}
  16  batch.recipe_chosen  {"recipe":"bugfix","reason":"a smaller fix will do","source":"human","by":"alice","via":"terminal"}
  17  step.scheduled       {"stepId":"plan","attempt":1,"deadlineAt":"2026-10-15T10:00:00.000Z"}
  18  batch.stuck          {"reason":{"kind":"deadline_passed","stepId":"plan","deadlineAt":"2026-10-15T10:00:00.000Z"},"options":["retry","rewind","cancel"],"remindAt":"2026-10-17T09:00:00.000Z"}
  19  batch.rewound        {"toStepId":"plan","by":"alice","via":"plugin","shas":{"acme/app":"4b825dc642cb6eb9a060e54bf8d69288fbee4904"}}

State
  state   Running: between steps
  parent  12-1
  recipe  bugfix, chosen by alice from a terminal: a smaller fix will do
  steps
    plan  #1 scheduled, abandoned
  rewinds
    to plan by alice via plugin

`;

