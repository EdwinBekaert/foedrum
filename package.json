{
  "name": "foedrum",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub-native orchestrator that runs Claude brewers through recipes and turns issues into pull requests",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "foedrum": "src/cli/main.ts"
  },
  "engines": {
    "node": ">=24.15"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "biome check",
    "test": "node scripts/with-checkout-tmp.ts --import ./scripts/test-cpu-time.ts --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-reporter=./scripts/spec-reporter.ts --test-reporter-destination=stdout --test-reporter=./scripts/test-budget-reporter.ts --test-reporter-destination=stdout \"test/{unit,property,chaos}/**/*.test.ts\"",
    "test:integration": "node scripts/with-checkout-tmp.ts --test \"test/integration/**/*.test.ts\"",
    "check": "node scripts/check.ts",
    "check:deps": "node scripts/check-deps.ts",
    "deps:sync": "node scripts/deps-sync.ts",
    "schemas": "node scripts/generate-schemas.ts",
    "worktrees:clean": "node scripts/worktrees-clean.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
