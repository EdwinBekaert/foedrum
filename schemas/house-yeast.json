{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "globs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+#.-]*$"
        },
        "lens": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
            },
            {
              "type": "string",
              "pattern": "^(?:diff|plan)\\/(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "structural",
        "semantic"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "\\S",
      "description": "The review or comment that produced the rule"
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ]
    }
  },
  "required": [
    "id",
    "scope",
    "kind",
    "source",
    "created",
    "status"
  ],
  "additionalProperties": false
}
