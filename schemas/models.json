{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema of this file, for editors",
      "type": "string"
    },
    "claude": {
      "default": {
        "models": {},
        "efforts": {}
      },
      "description": "What Foedrum's levels and efforts are for the claude agent (ADR 0397)",
      "type": "object",
      "properties": {
        "models": {
          "default": {},
          "description": "The model id or family `claude --model` gets for each level",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "light",
              "standard",
              "strong",
              "extreme"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}(?:\\[1m\\])?$"
          }
        },
        "efforts": {
          "default": {},
          "description": "The word `claude --effort` gets for each of Foedrum's efforts",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "small",
              "moderate",
              "larger",
              "full"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
