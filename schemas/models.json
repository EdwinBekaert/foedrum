{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema of this file, for editors",
      "type": "string"
    },
    "claude": {
      "default": {
        "models": {},
        "efforts": {},
        "tasted": []
      },
      "description": "What Foedrum's levels and efforts are for the claude agent (ADR 0397)",
      "type": "object",
      "properties": {
        "models": {
          "default": {},
          "description": "The model id or family `claude --model` gets for each level",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "light",
              "standard",
              "strong",
              "extreme"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}(?:\\[1m\\])?$"
          }
        },
        "efforts": {
          "default": {},
          "description": "The word `claude --effort` gets for each of Foedrum's efforts",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "small",
              "moderate",
              "larger",
              "full"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        },
        "tasted": {
          "default": [],
          "description": "The latest Flight of each brewer, recipe, level and effort (ADR 0416)",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "brewer": {
                "type": "string",
                "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
              },
              "recipe": {
                "type": "string",
                "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
              },
              "level": {
                "type": "string",
                "enum": [
                  "light",
                  "standard",
                  "strong",
                  "extreme"
                ]
              },
              "effort": {
                "type": "string",
                "enum": [
                  "small",
                  "moderate",
                  "larger",
                  "full"
                ]
              },
              "model": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}(?:\\[1m\\])?$",
                "description": "The exact model id the candidate Flight’s transcripts named"
              },
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The orders the candidate passed in every run"
              },
              "runs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The orders both Flights measured, not the runs brewed"
              },
              "baseline": {
                "type": "object",
                "properties": {
                  "passed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "The orders the baseline passed in every run"
                  },
                  "runs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "The orders both Flights measured, not the runs brewed"
                  },
                  "model": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}(?:\\[1m\\])?$",
                    "description": "The exact model id the baseline Flight’s transcripts named"
                  }
                },
                "required": [
                  "passed",
                  "runs",
                  "model"
                ],
                "additionalProperties": false,
                "description": "The Flight the candidate was compared with"
              },
              "tokensPerOrder": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "report": {
                "description": "The pull request that holds the Flight report",
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "brewer",
              "recipe",
              "level",
              "effort",
              "model",
              "passed",
              "runs",
              "baseline",
              "tokensPerOrder",
              "date"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
