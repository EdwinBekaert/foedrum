{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "succeeded"
        },
        "output": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "output"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "failed"
        },
        "retryable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "retryable",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "needs_input"
        },
        "questions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "pattern": "\\S"
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "recommended": {
                "type": "string",
                "pattern": "\\S"
              },
              "whyBlocking": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "q",
              "options",
              "recommended",
              "whyBlocking"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "questions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cancelled"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
