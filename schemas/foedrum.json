{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema of this file, for editors",
      "type": "string"
    },
    "brewery": {
      "description": "The Brewery's own owner/name on GitHub; foedrum serve needs it (ADR 0063)",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*\\/(?!\\.\\.?$)[\\w.][\\w.-]*$"
    },
    "githubApi": {
      "description": "The GitHub REST API's base URL; default https://api.github.com",
      "type": "string",
      "format": "uri"
    },
    "users": {
      "description": "The GitHub users who may order work: only their issues become orders",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      }
    },
    "concurrency": {
      "description": "How many batches may be Ordered or Brewing at once; default 1 (ADR 0068)",
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "pollEvery": {
      "description": "How often the intake polls GitHub, from \"30s\" to \"1h\"; default \"60s\" (ADR 0052)",
      "type": "string",
      "pattern": "^[1-9][0-9]*[smhd]$"
    },
    "isolation": {
      "description": "The isolation the Brewery needs; for now only check steps refuse to run below it",
      "type": "object",
      "properties": {
        "minimum": {
          "type": "string",
          "enum": [
            "sandboxed",
            "permissions only"
          ],
          "description": "The lowest isolation level the Brewery runs at (ADR 0010, ADR 0076)"
        }
      },
      "required": [
        "minimum"
      ],
      "additionalProperties": false
    },
    "keepAwake": {
      "description": "Whether brew and serve keep the machine from sleeping on its idle timer while an attempt runs; default true (ADR 0195)",
      "type": "boolean"
    },
    "permissionCeiling": {
      "default": [],
      "description": "The most any repository may add to its brewers; a rule covers narrower ones",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][\\w-]*(?:\\([^\\r\\n]+\\))?$"
      }
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*\\/(?!\\.\\.?$)[\\w.][\\w.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "object",
            "properties": {
              "build": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "run": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "windows": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "macos": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "linux": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          }
                        },
                        "required": [
                          "run"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "typecheck": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "run": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "windows": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "macos": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "linux": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          }
                        },
                        "required": [
                          "run"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lint": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "run": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "windows": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "macos": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "linux": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          }
                        },
                        "required": [
                          "run"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "format": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "run": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "windows": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "macos": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "linux": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          }
                        },
                        "required": [
                          "run"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "test": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "run": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "windows": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "macos": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          },
                          "linux": {
                            "type": "string",
                            "allOf": [
                              {
                                "pattern": "\\S"
                              },
                              {
                                "pattern": "^[^\\r\\n]*$"
                              }
                            ]
                          }
                        },
                        "required": [
                          "run"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "build",
              "typecheck",
              "lint",
              "format",
              "test"
            ],
            "additionalProperties": false,
            "description": "The command behind each check recipes name, or null when the repository has none"
          },
          "testReport": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "const": "tap"
                  },
                  "path": {
                    "description": "Without a path, the test command writes TAP to stdout",
                    "type": "string",
                    "pattern": "^(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|(?:[cC][oO][mM]|[lL][pP][tT])[1-9])(?:\\.|\\/|$))[^/\\\\:*?\"<>|\\x00-\\x1f]*[^/\\\\:*?\"<>|\\x00-\\x1f. ](?:\\/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|(?:[cC][oO][mM]|[lL][pP][tT])[1-9])(?:\\.|\\/|$))[^/\\\\:*?\"<>|\\x00-\\x1f]*[^/\\\\:*?\"<>|\\x00-\\x1f. ])*$"
                  }
                },
                "required": [
                  "format"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "const": "junit"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|(?:[cC][oO][mM]|[lL][pP][tT])[1-9])(?:\\.|\\/|$))[^/\\\\:*?\"<>|\\x00-\\x1f]*[^/\\\\:*?\"<>|\\x00-\\x1f. ](?:\\/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|(?:[cC][oO][mM]|[lL][pP][tT])[1-9])(?:\\.|\\/|$))[^/\\\\:*?\"<>|\\x00-\\x1f]*[^/\\\\:*?\"<>|\\x00-\\x1f. ])*$"
                  }
                },
                "required": [
                  "format",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          },
          "setup": {
            "description": "Runs in the worktree of a brewer attempt with a shell before the brewer and in a check step's before its checks, in the check sandbox with the network kept (ADR 0158, ADR 0163)",
            "type": "object",
            "properties": {
              "command": {
                "anyOf": [
                  {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[^\\r\\n]*$"
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "run": {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      "windows": {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      "macos": {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      },
                      "linux": {
                        "type": "string",
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\r\\n]*$"
                          }
                        ]
                      }
                    },
                    "required": [
                      "run"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "timeout": {
                "type": "string",
                "pattern": "^[1-9][0-9]*[smhd]$",
                "description": "A positive whole number of seconds, minutes, hours or days: \"90s\", \"30m\", \"2h\", \"3d\""
              }
            },
            "required": [
              "command",
              "timeout"
            ],
            "additionalProperties": false
          },
          "tools": {
            "default": [],
            "description": "Toolchain rules added to every brewer's allowlist, within the permission ceiling",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][\\w-]*(?:\\([^\\r\\n]+\\))?$"
            }
          },
          "houseYeast": {
            "default": "repo",
            "description": "Where repository-layer house-yeast rules are kept (ADR 0018)",
            "type": "string",
            "enum": [
              "repo",
              "brewery"
            ]
          },
          "alias": {
            "description": "The short name that starts the batch ids of its claimed issues; required with an intake",
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{0,19}$"
          },
          "intake": {
            "type": "object",
            "properties": {
              "labels": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Labels an issue must all have"
              },
              "milestone": {
                "description": "The milestone an issue must be in",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "labels"
            ],
            "additionalProperties": false,
            "description": "Polls the repository for issues to claim and brew; without it, none are"
          },
          "source": {
            "description": "Where attempt worktrees come from: the user's clone (local, the default) or a managed clone (ADR 0012)",
            "type": "string",
            "enum": [
              "local",
              "managed"
            ]
          },
          "base": {
            "description": "The branch attempts start from, at origin/<base> after a fetch; default main (ADR 0063)",
            "type": "string",
            "pattern": "^(?![-./])(?!.*\\.\\.)(?!.*\\/\\/)(?!.*\\/\\.)(?!.*\\.lock$)[A-Za-z0-9._/-]{1,200}(?<![/.])$"
          },
          "sensitivePaths": {
            "description": "Path globs whose files a batch's status comment names when its change touches them; never an approval or a block (ADR 0201)",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "checks"
        ],
        "additionalProperties": false
      },
      "description": "The target repositories, by owner/name"
    }
  },
  "required": [
    "repositories"
  ],
  "additionalProperties": false
}
