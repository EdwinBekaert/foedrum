# The root .npmrc's hardening, which npm does not read for this nested package (ADR 0399)
# Never run dependency lifecycle scripts
ignore-scripts=true
# A version must be at least 7 days old before it can be resolved.
# Applies to resolution only: versions already in this lockfile are not re-checked, since the
# dependency guard reads only the root one; each reviewed Dependabot bump stands in (ADR 0399).
min-release-age=7
# Exact versions in package.json
save-exact=true
# Registry tarballs only: no git or remote URL dependencies
allow-git=none
allow-remote=none
# Do not auto-install peer dependencies
omit=peer
# Refuse unsupported Node/npm versions
engine-strict=true
fund=false
