{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "npm run --silent hook:gate",
            "timeout": 600,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "npm run --silent hook:gate",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git *)",
            "command": "npm run --silent hook:gate",
            "timeout": 600,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(gh *)",
            "command": "npm run --silent hook:gate",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
