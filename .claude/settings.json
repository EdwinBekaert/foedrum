  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent --prefix \"${CLAUDE_PROJECT_DIR}\" deps:sync || true",
            "shell": "bash",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "npm run --silent --prefix \"${CLAUDE_PROJECT_DIR}\" worktrees:clean -- --session-start || true",
            "shell": "bash",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/precheck.ts\" || { s=$?; [ \"$s\" = 2 ] || echo \"Foedrum gate could not run (exit $s); command blocked.\" >&2; exit 2; }",
            "shell": "bash",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/precheck.ts\" || { s=$?; [ \"$s\" = 2 ] || echo \"Foedrum gate could not run (exit $s); command blocked.\" >&2; exit 2; }",
            "shell": "bash",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
