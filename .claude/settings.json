{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge origin/main)",
      "Bash(git worktree list)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh repo view *)",
      "PowerShell(npm ci)",
      "PowerShell(npm run *)",
      "PowerShell(npm test)",
      "PowerShell(node --test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git fetch *)",
      "PowerShell(git merge origin/main)",
      "PowerShell(git worktree list)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh repo view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue comment *)",
      "Bash(gh api *)",
      "Bash(npm install *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gh api *)",
      "PowerShell(npm install *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(npm publish *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo rename *)",
      "PowerShell(gh repo archive *)",
      "PowerShell(npm publish *)",
      "Edit(/.npmrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent --prefix \"${CLAUDE_PROJECT_DIR}\" hook:gate || { echo \"Foedrum gate could not run (npm failed); command blocked. Run npm run check yourself to see why.\" >&2; exit 2; }",
            "shell": "bash",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent --prefix \"${CLAUDE_PROJECT_DIR}\" hook:gate || { echo \"Foedrum gate could not run (npm failed); command blocked. Run npm run check yourself to see why.\" >&2; exit 2; }",
            "shell": "bash",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
