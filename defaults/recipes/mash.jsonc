// Mash, a plan of an order (ADR 0234): the Brewmaster reads the order and its repository and breaks
// the order into sub-orders, one repository each, with the recipe each should run with. Nothing is
// built: three Tasters review the plan side by side (ADR 0321), coverage's and sizing's changes
// send it back to the Brewmaster, and the plan is shown on the order's issue (ADR 0233), where the
// batch waits Stuck for its review (ADR 0275) until foedrum approve signs it off (ADR 0281).
// The lauter step runs only when a person chooses foedrum lauter at that review: the Brewmaster
// corrects the plan with them in a session, and the batch waits for a review of that plan
// (ADR 0286).
{
  "$schema": "../../schemas/recipe.json",
  "name": "mash",
  "description": "Plan an order as sub-orders through three lenses, shown on its issue; nothing is built",
  // It commits nothing, so there is no test to write first.
  "testFirst": false,
  "steps": [
    { "id": "plan", "brewer": "brewmaster" },
    {
      "id": "taste",
      "parallel": [
        // Blocking: a wrong or oversized cut wastes every sub-order built from it. Once all three
        // Tasters end, the first one's changes send the plan back, each of the two twice at most.
        {
          "id": "coverage",
          "brewer": "taster",
          "lens": "plan/coverage",
          // It reads the code as well as the plan, to tell what the code already does.
          "model": "planner",
          "blocking": true,
          "onBlocked": { "findings": { "goto": "plan", "maxRounds": 2 } }
        },
        {
          "id": "sizing",
          "brewer": "taster",
          "lens": "plan/sizing",
          "blocking": true,
          "onBlocked": { "findings": { "goto": "plan", "maxRounds": 2 } }
        },
        // Advisory: every finding shows in the plan comment's Review.
        { "id": "naive-reader", "brewer": "taster", "lens": "plan/naive-reader" }
      ]
    },
    {
      "id": "lauter",
      "brewer": "brewmaster",
      "interactive": true,
      "chosenBy": "lauter",
      "prompt": "The person in this session reviews the plan in {plan} and chose to correct it with you. Greet them, sum the plan up in a few lines, and ask what they want to change. Then correct it together, as your instructions say, and end with the whole corrected plan as your out doc."
    }
  ]
}
