// Nip, the quick fix in one repository, test-first (ADR 0017): the Gauger commits failing tests,
// the red proof shows they fail for the missing behaviour, Cellarman makes them pass, the Finer
// simplifies the change (ADR 0166), the checks read the result, the Taster reviews the change
// through the correctness lens, and the pull request opens with its findings (ADR 0161).
{
  "$schema": "../../schemas/recipe.json",
  "name": "nip",
  "description": "Quick fix in one repository, test-first",
  "match": { "labels": ["quick-fix"] },
  "steps": [
    { "id": "gauge", "brewer": "gauger", "when": "recipe.testFirst" },
    {
      "id": "red",
      "check": "test",
      "expect": "fail",
      "of": "gauge",
      "when": "recipe.testFirst",
      "onFail": { "goto": "gauge", "maxRounds": 1 }
    },
    {
      "id": "implement",
      "brewer": "cellarman",
      // A test Cellarman finds wrong goes back to the Gauger, once (ADR 0017, ADR 0064).
      "onBlocked": { "findings": { "goto": "gauge", "maxRounds": 1 } }
    },
    { "id": "fine", "brewer": "finer" },
    {
      // A failure goes back to Cellarman, whichever step broke it; the Finer then runs again.
      "id": "green",
      "check": ["build", "typecheck", "lint", "format", "test"],
      "onFail": { "goto": "implement", "maxRounds": 1 }
    },
    // Advisory: the findings are listed in the pull request and the status comment.
    { "id": "taste", "brewer": "taster", "lens": "diff/correctness" },
    { "action": "openPullRequest" }
  ]
}
