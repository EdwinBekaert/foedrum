// Nip, the quick fix in one repository, test-first (ADR 0017): the Maltster first proposes the
// repository's test map when it has none or a stale one, checked against one run of its tests
// (ADR 0282, ADR 0298); then the Gauger commits failing tests,
// the red proof shows they fail for the missing behaviour, Cellarman makes them pass, the Finer
// simplifies the change (ADR 0166), the checks read the result, four Tasters review the change side
// by side, through the correctness, acceptance, security and design conformance lenses (ADR 0168,
// ADR 0197, ADR 0306, ADR 0343), every finding of theirs sends the batch back to Cellarman
// (ADR 0354), after which correctness and the Tasters that had findings run again (ADR 0357), and
// the pull request opens with what came of them (ADR 0161). Correctness,
// acceptance and security run at high effort, and design conformance at the Taster's own medium
// (ADR 0352).
{
  "$schema": "../../schemas/recipe.json",
  "name": "nip",
  "type": "brew",
  "description": "Builds a change in one repository, test-first, through four diff lenses",
  "guidance": {
    "chooseWhen": "A fix or a small feature in one repository whose effect stays inside the code it changes: no caller, shared path or other repository depends on what it changes.",
    "notWhen": "A change that can reach a lot, however small: a loop over every item, a shared path, a public interface, a credential, a migration or what other repositories read. Choose deep-brew for it.",
    "bestUsed": "With one clear outcome a test can show. Its Tasters read the diff and no mutants run, so a fix whose effect reaches past the diff can pass them."
  },
  "steps": [
    // Without a session when the base's map is fresh, or the Brewery keeps it (ADR 0298).
    { "id": "survey", "brewer": "maltster", "when": "recipe.testFirst" },
    {
      // A run that disagrees with the proposed map goes back to the Maltster once, then the batch
      // is Stuck on its environment (ADR 0298).
      "id": "survey-check",
      "check": "test",
      "of": "survey",
      "when": "recipe.testFirst",
      "onFail": { "goto": "survey", "maxRounds": 1 }
    },
    { "id": "gauge", "brewer": "gauger", "when": "recipe.testFirst" },
    {
      "id": "red",
      "check": "test",
      "expect": "fail",
      "of": "gauge",
      "when": "recipe.testFirst",
      "onFail": { "goto": "gauge", "maxRounds": 1 }
    },
    {
      "id": "implement",
      "brewer": "cellarman",
      // A test Cellarman finds wrong goes back to the Gauger, once (ADR 0017, ADR 0064).
      "onBlocked": { "findings": { "goto": "gauge", "maxRounds": 1 } }
    },
    { "id": "fine", "brewer": "finer" },
    {
      // A failure goes back to Cellarman, whichever step broke it; the Finer then runs again.
      "id": "green",
      "check": ["build", "typecheck", "lint", "format", "test"],
      "onFail": { "goto": "implement", "maxRounds": 1 }
    },
    // Every finding of every Taster goes back to Cellarman once all four ended, fixed or dismissed
    // there with a reason, through the Finer and green again: two rounds in each run, then the
    // batch is Stuck with the findings still open (ADR 0192, ADR 0354, ADR 0369). A round back runs correctness and
    // the Tasters that had findings again; one that found nothing keeps its approval (ADR 0357).
    {
      "id": "taste",
      "parallel": [
        // The one Taster that reads the whole change again after every round back (ADR 0357).
        {
          "id": "correctness",
          "brewer": "taster",
          "lens": "diff/correctness",
          "effort": "high",
          "everyRound": true
        },
        // Whether the change builds each item of the order's checklist, and nothing else.
        { "id": "acceptance", "brewer": "taster", "lens": "diff/acceptance", "effort": "high" },
        // Untrusted input the change handles, and where it goes (ADR 0306).
        { "id": "security", "brewer": "taster", "lens": "diff/security", "effort": "high" },
        // The repository's decisions and documents the change contradicts or leaves stale
        // (ADR 0343), judged by the rules its lens has it read (ADR 0352).
        { "id": "design-conformance", "brewer": "taster", "lens": "diff/design-conformance" }
      ],
      "onFindings": { "goto": "implement", "maxRounds": 2 }
    },
    // A check that fails on the pull request's head sends the batch back to Cellarman, twice at most,
    // and the fix is pushed to the same pull request (ADR 0219).
    { "action": "openPullRequest", "onPullRequestFail": { "goto": "implement", "maxRounds": 2 } }
  ]
}
