# Supply-chain hardening — see DEPENDENCIES.md and docs/adr/0004
# Never run dependency lifecycle scripts
ignore-scripts=true
# A version must be at least 7 days old before it can be installed
min-release-age=7
# Exact versions in package.json
save-exact=true
# Registry tarballs only: no git or remote URL dependencies
allow-git=none
allow-remote=none
# Do not auto-install peer dependencies
omit=peer
# Refuse unsupported Node/npm versions
engine-strict=true
fund=false
